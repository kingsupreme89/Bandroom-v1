# Secrets -- never commit these. Real live credentials as of 2026-08-07:
# admin_token.local.txt, google_client_secret.local.txt
*.local.txt
*secret*
*token*
!docs/**
!**/*Token*.cs
!**/*Secret*.cs

# .NET build output
bin/
obj/
**/bin/
**/obj/

# WebView2 runtime cache/profile data
WebView2Data/

# User-owned data that shouldn't be versioned (mirrors ConfigStore.UserDataRoot conventions)
crash.log
*.user

# Python venv (scripts/ tooling)
.venv/
__pycache__/

# Squirrel release output -- built fresh by release.ps1 on every release, not source; the
# .nupkg/.exe installer binaries here are tens of MB each and blew up a push (timed out) when
# accidentally committed once already.
squirrel_releases/

# Working mirror of build output pushed to teammates via "8888" -- not source, hundreds of
# files, don't want release.ps1's `git add -A` sweeping it into commits.
publish-dev-share/
publish-dev-share-lite/
*.rar

# Local secrets -- contains a real ElevenLabs API key, was accidentally committed by
# release.ps1's `git add -A` step (2026-08-11), flagged since Session 36.
voice_poc/.env

# Cloudflare Workers local dev state (wrangler dev/miniflare cache, sqlite, R2 emulation) --
# machine-local build/runtime artifacts, not source.
.wrangler/
**/.wrangler/

# Claude Code agent worktrees -- each is its own nested git clone (has its own .git/), used for
# isolated background agent sessions. Never commit these into the main repo: doing so would embed
# a full second copy of the repo's history (multi-GB) as plain directory content instead of a
# proper submodule/worktree reference.
.claude/worktrees/

# Internal planning/pitch/architecture guides -- personal-machine reference only, not meant to
# ship in the public repo (they describe internal design/roadmap, not code).
BANDROOM_AUDIO_TECHNOLOGY_GUIDE.md
BANDROOM_PITCH_DECK.md
BANDROOM_STREAMER_MASTER_PROMPT.md
BANDROOM_TECHNOLOGY_GUIDE.md
