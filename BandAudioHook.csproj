<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Bandroom</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);src\**\*</DefaultItemExcludes>
    <RootNamespace>Bandroom</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Squirrel's aware-app detector only scans .exe files — it never sees attributes on
       Bandroom.dll, and the .NET 5+ apphost.exe is a native stub with no CLR metadata to hold
       AssemblyMetadataAttribute anyway. A "<exe>.squirrel" sidecar containing the version is the
       detector's documented fallback, so ship one next to the apphost every build. -->
  <ItemGroup>
    <Content Include="Bandroom.exe.squirrel" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SoundTouch.Net" Version="2.3.1" />
    <ProjectReference Include="src\Bandroom.Core\Bandroom.Core.csproj" />
    <PackageReference Include="Clowd.Squirrel" Version="2.11.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Reads the ID3 Title tag off Default Song Pack files (Sound Bank browsing redesign):
         pack filenames are EventKey-shaped ("Defense_Third Down_5.mp3"), but the files themselves
         carry a real Title tag ("sec socar '21 D stop") that's far more useful to show in the
         picker. See WebMainForm's GetDefaultPackSongsForTeamFromWeb/GetConferencePackSongsForTeamFromWeb. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <!-- Debug-only: lets InitWebViewAsync's orphan-cleanup step (see WebMainForm.cs) query
         msedgewebview2.exe command lines via WMI to find/kill ones bound to OUR OWN
         WebView2Data profile folder left over from a previous session that was force-killed
         (e.g. via a dev-loop taskkill) rather than closed cleanly, since those can keep holding
         cache files locked/stale independent of a fresh process's own cache-clear call. -->
    <PackageReference Include="System.Management" Version="8.0.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\Outfit-Regular.ttf" />
    <EmbeddedResource Include="Fonts\Outfit-Medium.ttf" />
    <EmbeddedResource Include="Fonts\Outfit-SemiBold.ttf" />
    <EmbeddedResource Include="Fonts\Outfit-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Data tables for IntakeEngine.cs (filename-based team/trigger auto-indexing): same
         registries scripts/intake_engine.py uses, kept as the single source of truth so both
         stay in sync instead of duplicating the team/trigger lists in C# source. -->
    <Content Include="scripts\team_registry.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="scripts\trigger_event_map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- TeamBackgrounds was never wired into the build output before: ConfigStore only
         creates an empty folder if missing, so the backdrop images silently never made it to
         bin\, which is why team selection never changed the background. -->
    <Content Include="TeamBackgrounds\**\*" Exclude="TeamBackgrounds_original_fullres\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TeamLogos\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 2,241 files / 2.8GB: bundling this pushes the installer past GitHub Releases' 2GB
         per-asset cap, so public builds publish with /p:BundleDefaultSongs=false and the app
         fetches the pack separately (DefaultSongPackService) after install. Defaults to true so
         local dev builds keep working exactly as before. -->
    <Content Include="Songs\Default\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Songs\Default" Condition="'$(BundleDefaultSongs)' != 'false'" />
    <!-- Assets\ScoreboardReader\: bundled read-only RAM reader (owner-approved absorption of
         Coffee's CollegeFB27RamReader.exe, 2026-08-13): standalone/self-contained, zero DLL deps,
         shipped with its own ram-live-profile.json sidecar so BANDroom never depends on Coffee's
         separate Electron install being present. Launched as a child process by
         ScoreboardReaderHost, covered by this same glob, no separate Content entry needed. -->
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Gitignored (see GoogleAuthService.cs's ClientSecret): kept out of the public source repo
         per GitHub's push protection, but still needs to ship INSIDE the built app so every
         installed copy can complete Google sign-in, not just this dev machine. Condition means a
         fresh clone without the file still builds fine (sign-in just stays inert, same as before
         the Client ID was ever configured). -->
    <Content Include="google_client_secret.local.txt" Condition="Exists('google_client_secret.local.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
